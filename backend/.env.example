DJANGO_SETTINGS_MODULE=chindler_backend.settings.local
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, informe a URL PostgreSQL fornecida pela hospedagem:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_AGE=28800

# Configure um provedor SMTP em produção para recuperação de senha.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Chindler <noreply@chindler.com.br>

# Deixe vazio no desenvolvimento para salvar em backend/media.
# Em produção, use o valor fornecido pelo painel Cloudinary.
CLOUDINARY_URL=
PROPERTY_IMAGE_MAX_BYTES=15728640
PROPERTY_IMAGE_MAX_PIXELS=40000000
PROPERTY_IMAGE_MAX_WIDTH=2400
PROPERTY_IMAGE_MAX_HEIGHT=1800
PRIVACY_POLICY_VERSION=1.0
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
